AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_INDEX=enterprise-documents
AZURE_SEARCH_SEMANTIC_CONFIG=semantic-config
AZURE_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_REQUIRED_SCOPE=Research.Read
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=enterprise-multi-agent-rag
